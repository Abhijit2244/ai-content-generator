# ==============================================================================
# AI Content Generator - Root Environment Configuration Example
# Copy this file or check service-specific .env.example files
# ==============================================================================

# Backend (Node.js Express API)
NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ACCESS_TOKEN_TTL=24h
FRONTEND_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=internal-secret-token-between-node-and-fastapi

# AI Service (Python FastAPI)
APP_ENV=development
AI_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend (React + Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
